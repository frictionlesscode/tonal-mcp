# Same account-level access tonal-garmin-sync already uses -- Tonal has no
# public API, no OAuth, no personal access tokens. This signs in the same way
# the mobile app does, against the same private Auth0 tenant.
TONAL_EMAIL=
TONAL_PASSWORD=

# Used as the one-time login-form password for OAuth clients (see oauth.py) --
# no longer sent on every request once a client has an access token.
MCP_BEARER_TOKEN=
# The public URL this server is actually reachable at (Tailscale Funnel).
# Required for correct OAuth issuer/redirect URLs.
MCP_PUBLIC_URL=

TZ=America/New_York
LOG_LEVEL=INFO
